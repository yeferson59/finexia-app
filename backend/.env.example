# Copy to .env and fill in. Only the variables under "Required" have to be set
# for the API to start; everything else has a working default for local
# development (see internal/platform/config/env.go).

# --- Required ---------------------------------------------------------------

DATABASE_URL=postgres://postgres:postgres@localhost:5432/finexia?sslmode=disable
CACHE_URL=redis://localhost:6379/0

# Signs every access token. There is no default and the API refuses to start
# without it: a fallback value would mean anyone who has read this repository
# could mint a token for any user id and any role — "admin" included — against
# a deployment that simply forgot to set the variable.
#
# Must be at least 32 characters and must not be a padded placeholder or a
# short string repeated up to that length; both are rejected at startup.
# Generate one with:
#
#     openssl rand -base64 48
#
# Rotating it invalidates every access token in flight (users re-authenticate
# through their refresh cookie, which is not signed with this key).
JWT_SECRET=

# Key-encryption keys for the market-data API keys users bring (BYO-key).
#
# Format: comma-separated "version:base64key" entries. The version is a decimal
# integer; the key is standard base64 that must decode to exactly 32 bytes
# (AES-256). Generate one with:
#
#     openssl rand -base64 32
#
# The API refuses to start without this. That is deliberate: a default value
# would mean every deployment sealed its users' keys under something guessable,
# and the whole point of the envelope encryption is that a dump of the database
# is not enough to recover anybody's key — because the key that unwraps them
# lives here, in the environment, and never in Postgres.
#
# To rotate: add a new version, point MARKET_KEK_ACTIVE at it, and keep the old
# one listed until every row has been re-wrapped. Rotation only re-wraps the
# per-credential data key, so users never have to re-enter their API keys.
MARKET_KEK_KEYS=1:REPLACE_WITH_OPENSSL_RAND_BASE64_32
MARKET_KEK_ACTIVE=1

# --- Server -----------------------------------------------------------------

PORT=8080
ENVIRONMENT=development
PATH_MIGRATION=internal/migrations

# PUBLIC_URL es la URL base de esta API, y FRONTEND_URL la de la app web.
#
# Las dos son críticas para el servidor OAuth de /mcp (docs/API.md §2.12), no
# solo para los enlaces de los correos: PUBLIC_URL es el `issuer` que publica la
# metadata, y un cliente MCP compara ese valor con el origen desde el que la
# descargó. Si no coincide con cómo se llega de verdad al API, TODAS las
# conexiones fallan en el descubrimiento, antes de que nadie vea una pantalla.
# FRONTEND_URL es a dónde se manda el navegador a dar el consentimiento.
#
# En producción: PUBLIC_URL=https://api.finexia.me y FRONTEND_URL=https://finexia.me
PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173

# TRUST_PROXY lets c.IP() read the client address from X-Forwarded-For, which
# every rate limiter keys on. Loopback, link-local and private ranges are
# trusted implicitly; list any additional proxy addresses in TRUSTED_PROXIES.
# The header is parsed and validated (the chain is walked right-to-left and
# trusted hops are skipped), so a forged value cannot become a limiter key —
# but set TRUSTED_PROXIES when the ingress sits outside those ranges, and set
# TRUST_PROXY=false when the API is exposed directly with no proxy in front.
TRUST_PROXY=true
TRUSTED_PROXIES=

# CORS_ENABLED=false drops the Access-Control-* headers entirely, which is the
# right setting when the frontend is served from the same origin.
CORS_ENABLED=true
CORS_ORIGIN=http://localhost:5173

# --- Auth -------------------------------------------------------------------

JWT_ACCESS_DURATION=15m
JWT_REFRESH_DURATION=720h
JWT_REFRESH_GRACE_PERIOD=30s
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION=15m
TWO_FACTOR_PENDING_EXPIRY=5m
INVITATION_EXPIRY=72h
PASSWORD_RESET_EXPIRY=1h
EMAIL_VERIFICATION_EXPIRY=24h
# Off by default: the product is invite-only, so public sign-up is opt-in.
SELF_REGISTRATION_ENABLED=false

# --- Email (Resend) ---------------------------------------------------------

RESEND_API_KEY=
EMAIL_FROM=Finexia <noreply@finexia.me>

# --- Object storage (S3-compatible) -----------------------------------------

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_ENDPOINT_URL=
AWS_S3_BUCKET_NAME=

# --- Not here on purpose ----------------------------------------------------
#
# There are no market-data provider keys in this file. Under BYO-key the
# application holds none: each user supplies their own in Settings → Market
# data, and it is stored sealed under MARKET_KEK_KEYS. ALPHA_VANTAGE_API_KEY and
# FINNHUB_API_KEY are no longer read by anything.
